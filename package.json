    "demo": "bun run --filter @altpool/demo demo"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
